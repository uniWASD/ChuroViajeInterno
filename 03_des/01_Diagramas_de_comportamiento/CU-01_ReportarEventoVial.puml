@startuml CU-01_ReportarEventoVial
' CU-01: Reportar Evento Vial - Diagrama de comportamiento (actividad)
' Fuente: 02_req - Especificación de Casos de Uso (CU-01 a CU-09), secciones 4 y 6
' Issue: T-045 (actualizado en T-086)
' Revisión de coherencia (06/10/2026): modal con tipo y tiempo, descarte del reporte vencido y propagación por consulta periódica.
' Sprint 6.5 (#191): hoja «Notificar evento» desde la campana o desde un lugar elegido, y punto a 1 km o menos (RN-01.5).

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam wrapWidth 200
skinparam ArrowColor #2F5D8A
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #2F5D8A
  StartColor #2F5D8A
  EndColor #2F5D8A
}
skinparam swimlane {
  BorderColor #2F5D8A
  TitleFontStyle bold
  TitleFontColor #1B365D
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
  FontSize 11
}

title CU-01: Reportar Evento Vial\nDiagrama de actividad

|Conductor|
start
:Toca la campana del
mapa, o "Notificar"
en un lugar que
eligió;
|Sistema ChuroViaje|
:Muestra la hoja
"Notificar evento"
con los tipos y el
tiempo ("5 min" por
defecto);
|Conductor|
:Selecciona el tipo
de evento y, si hace
falta, cambia el
tiempo o toca otro
punto cercano;
:Toca "Enviar";
|Sistema ChuroViaje|
:Toma la ubicación
GPS o el punto
elegido, a 1 km o
menos;
if (¿Hay conexión a\ninternet?) then (sí)
else (no [3a])
  #FFF8E1:[3a] Almacena el
reporte localmente;
  #FFF8E1:[3a] Reintenta el
envío
automáticamente al
recuperar la
conexión;
  if (¿El reporte\nsigue vigente?) then (sí)
    #FFF8E1:[3a] Notifica al
conductor el
estado del envío;
  else (no)
    #FFF8E1:[3a] Descarta el
reporte y avisa al
conductor;
    stop
  endif
endif
repeat
  |Sistema ChuroViaje|
  :Envía el reporte
al backend (tipo,
momento y
ubicación);
  |Backend Java|
  :Verifica el token
de sesión;
backward:[4a] El sistema
renueva la sesión o,
si no puede, el
conductor se
reautentica (CU-08),
y luego reintenta el
envío;
repeat while (¿El token\nexpiró?) is (sí [4a])
->no;
|Backend Java|
:Valida el reporte;
if (¿Lo acepta?) then (sí)
  :Persiste el
evento;
  :Confirma el
registro al
conductor;
else (no [4b])
  |Sistema ChuroViaje|
  #FFF8E1:[4b] Muestra el
motivo del rechazo
(fuera de Tarija,
a más de 1 km,
evento vencido,
repetido o límite
superado);
  #FFF8E1:[4b] El reporte
no se registra;
  stop
endif
|Demás conductores|
:Reciben el evento
en su siguiente
consulta periódica
(CU-02);
:El evento aparece
en su mapa en 5-10
s;
stop

legend bottom
  Azul: escenario principal de éxito (sección 4).
  Amarillo y flechas de retorno etiquetadas: extensiones y flujos alternativos
  (sección 6), con su referencia entre corchetes.
endlegend

@enduml
