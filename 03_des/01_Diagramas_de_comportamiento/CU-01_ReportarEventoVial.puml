@startuml CU-01_ReportarEventoVial
' CU-01: Reportar Evento Vial - Diagrama de comportamiento (actividad)
' Fuente: 02_req - Especificación de Casos de Uso (CU-01 a CU-08), secciones 4 y 6
' Issue: T-045

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam wrapWidth 200
skinparam ArrowColor #2F5D8A
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #2F5D8A
  StartColor #2F5D8A
  EndColor #2F5D8A
}
skinparam swimlane {
  BorderColor #2F5D8A
  TitleFontStyle bold
  TitleFontColor #1B365D
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
  FontSize 11
}

title CU-01: Reportar Evento Vial\nDiagrama de actividad

|Conductor|
start
:Abre el mapa y
presiona "Reportar
evento";
|Sistema ChuroViaje|
:Muestra la lista
de tipos de evento;
|Conductor|
:Selecciona el tipo
de evento;
|Sistema ChuroViaje|
:Captura la
ubicación GPS
actual;
|Conductor|
:Confirma el envío
del reporte;
|Sistema ChuroViaje|
if (¿Hay conexión a\ninternet?) then (sí)
else (no [3a])
  #FFF8E1:[3a] Almacena el
reporte localmente;
  #FFF8E1:[3a] Reintenta el
envío
automáticamente al
recuperar la
conexión;
  #FFF8E1:[3a] Notifica al
conductor el
estado del envío;
endif
repeat
  |Sistema ChuroViaje|
  :Envía el reporte
al backend;
  |Backend Java|
  :Verifica el token
de sesión;
backward:[4a] El conductor
se reautentica
(CU-08) y el
sistema reintenta
el envío;
repeat while (¿El token\nexpiró?) is (sí [4a])
->no;
|Backend Java|
:Valida y persiste
el evento;
:Confirma el
registro al
conductor;
|Módulo de distribución|
:Propaga el evento
a los demás
usuarios;
:El evento aparece
en su mapa en 5-10
s;
stop

legend bottom
  Azul: escenario principal de éxito (sección 4).
  Amarillo y flechas de retorno etiquetadas: extensiones y flujos alternativos
  (sección 6), con su referencia entre corchetes.
endlegend

@enduml
