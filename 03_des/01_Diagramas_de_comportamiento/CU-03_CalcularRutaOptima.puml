@startuml CU-03_CalcularRutaOptima
' CU-03: Calcular Ruta Óptima - Diagrama de comportamiento (actividad)
' Fuente: 02_req - Especificación de Casos de Uso (CU-01 a CU-08), secciones 4 y 6
' Issue: T-045 (actualizado en T-086)

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam wrapWidth 200
skinparam ArrowColor #2F5D8A
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #2F5D8A
  StartColor #2F5D8A
  EndColor #2F5D8A
}
skinparam swimlane {
  BorderColor #2F5D8A
  TitleFontStyle bold
  TitleFontColor #1B365D
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
  FontSize 11
}

title CU-03: Calcular Ruta Óptima\nDiagrama de actividad

|Conductor|
start
repeat
  |Conductor|
  :Ingresa origen,
destino y paradas
opcionales;
  |Sistema ChuroViaje|
  :Valida los puntos
ingresados;
backward:[1a] Muestra un
mensaje de error y
solicita un nuevo
destino;
repeat while (¿Destino\ninválido o fuera\nde cobertura?) is (sí [1a])
->no;
|Conductor|
:Solicita "Calcular
ruta";
|Backend Java|
:Valida la solicitud
y la envía al motor
core;
|Motor core|
:Ajusta los puntos a
la red de calles que
tiene en memoria;
:Ejecuta el
algoritmo (A*)
considerando los
eventos viales
vigentes;
if (¿Existe una ruta\nvehicular?) then (sí)
  |Sistema ChuroViaje|
  if (¿Carga el mapa\nbase de Mapbox?) then (sí)
    :Dibuja la ruta con
tiempo y distancia
estimados;
    |Conductor|
    :Confirma el inicio
de la navegación;
    |Sistema ChuroViaje|
    :Comienza el
seguimiento de la
ruta;
    stop
  else (no [4a])
    #FFF8E1:[4a] Informa un
error de servicio
externo y sugiere
reintentar más
tarde;
    stop
  endif
else (no [3a])
  |Sistema ChuroViaje|
  #FFF8E1:[3a] Notifica que
no se encontró una
ruta válida;
  stop
endif

legend bottom
  Azul: escenario principal de éxito (sección 4).
  Amarillo y flechas de retorno etiquetadas: extensiones y flujos alternativos
  (sección 6), con su referencia entre corchetes.
endlegend

@enduml
