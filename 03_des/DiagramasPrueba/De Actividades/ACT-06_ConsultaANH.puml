@startuml ACT-06_ConsultaANH
' Diagrama de actividad general: consulta periódica a ANH (CU-09)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 22
skinparam activity {
  BackgroundColor white
  BorderColor #222222
  BorderThickness 1.5
  DiamondBackgroundColor white
  DiamondBorderColor #222222
  StartColor #222222
  EndColor #222222
}
skinparam swimlane {
  BorderColor #333333
  BorderThickness 1
  TitleFontStyle bold
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}

title Diagrama de actividad: consulta a ANH

|Backend|
start
:Iniciar ciclo\nde consulta;
:Pedir estaciones de\nTarija a ANH;
|ANH|
:Entregar estaciones\ny litros;
|Backend|
:Validar respuesta;
if (¿Respuesta válida?) then (sí)
  :Ignorar estaciones fuera\nde Tarija o sin vincular;
  :Traducir litros a\ndisponible o agotado;
  :Guardar estado con\norigen ANH;
else (no)
  :Conservar el último\ndato conocido;
endif
stop

@enduml
