@startuml ACT-07_Simulador
' Diagrama de actividad general: simulador de tráfico (CU-07)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 22
skinparam activity {
  BackgroundColor white
  BorderColor #222222
  BorderThickness 1.5
  DiamondBackgroundColor white
  DiamondBorderColor #222222
  StartColor #222222
  EndColor #222222
}
skinparam swimlane {
  BorderColor #333333
  BorderThickness 1
  TitleFontStyle bold
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}

title Diagrama de actividad: simulador de tráfico

|Desarrollador|
start
:Configurar parámetros\nde carga;
:Ejecutar simulador;
|Simulador|
:Validar parámetros;
if (¿Parámetros válidos?) then (no)
  :Indicar los límites\npermitidos;
  stop
else (sí)
  :Crear usuarios\nfantasma;
  :Enviar eventos\ny telemetría;
  |Backend|
  :Procesar como datos reales\n(marcados como simulados);
  :Registrar la prueba;
  |Desarrollador|
  :Revisar resultados;
  :Eliminar datos\nsimulados;
  stop
endif

@enduml
