@startuml CLS-02_BackendJava_Dominio
' Diagrama de clases general: dominio del backend (Java)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor #555555
  HeaderBackgroundColor #E6E6E6
  FontStyle bold
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #999999
  BackgroundColor white
}
hide circle
hide empty members

title Diagrama de clases: Backend Java (dominio)

class Conductor {
  - id
  - googleId
  - fechaAlta
  - simulado
}
class "Sesión" as Sesion {
  - emitidaEn
  - expiraEn
  + estaVigente()
  + renovar()
}
class TipoEvento {
  - nombre
  - color
  - vigenciaMinutos
}
class EventoVial {
  - ocurrioEn
  - origen
  - estado
  - votosReal
  - votosFalso
  + estaVigente()
  + registrarVoto()
}
class Voto {
  - valor
  - fecha
}
class Surtidor {
  - nombre
  - alias
  - ubicacion
}
class EstadoCombustible {
  - tipoCombustible
  - origen
  - disponible
  - fechaDelDato
  + estaVigente()
}
class "ConfirmaciónRecarga" as ConfirmacionRecarga {
  - fecha
  + aplicar()
}
class ReporteANH {
  - idEstacion
  - litros
  - actualizadoEn
  + traducirLitros()
}

Conductor "1" *-- "0..*" Sesion
Conductor "1" -- "0..*" EventoVial : reporta
Conductor "1" -- "0..*" Voto : emite
Conductor "1" -- "0..*" ConfirmacionRecarga : hace
EventoVial "0..*" -- "1" TipoEvento
EventoVial "1" *-- "0..*" Voto
Surtidor "1" *-- "0..*" EstadoCombustible
ConfirmacionRecarga "0..*" -- "1" Surtidor
ReporteANH "0..*" -- "0..1" Surtidor : se vincula

@enduml
