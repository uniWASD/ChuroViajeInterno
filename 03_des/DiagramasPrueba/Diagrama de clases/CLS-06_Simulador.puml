@startuml CLS-06_Simulador
' Diagrama de clases general: simulador de tráfico (Python)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor #555555
  HeaderBackgroundColor #E6E6E6
  FontStyle bold
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #999999
  BackgroundColor white
}
hide circle
hide empty members

title Diagrama de clases: Simulador (Python)

class "Simulación" as Simulacion {
  - cantidadUsuarios
  - cantidadRutas
  - eventosAEnviar
  + validarParametros()
  + ejecutar()
  + eliminarDatosSimulados()
}
class UsuarioFantasma {
  - credencialesDePrueba
  - ruta
  + iniciarSesion()
  + enviarEvento()
  + enviarTelemetria()
}
class ClienteApi {
  - urlBase
  + enviar(peticion)
}

Simulacion "1" *-- "1..*" UsuarioFantasma
UsuarioFantasma --> ClienteApi : usa

@enduml
