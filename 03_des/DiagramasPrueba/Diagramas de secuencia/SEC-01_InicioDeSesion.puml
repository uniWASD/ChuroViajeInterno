@startuml SEC-01_InicioDeSesion
' Diagrama de secuencia general: inicio de sesión con Google
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 8
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #222222
  ActorBackgroundColor white
  ActorBorderColor #222222
  LifeLineBorderColor #555555
  LifeLineBackgroundColor white
  GroupBorderColor #777777
  GroupBackgroundColor white
  ArrowThickness 1.2
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
skinparam database {
  BackgroundColor white
  BorderColor #222222
}
skinparam responseMessageBelowArrow true
hide footbox
autonumber

title Diagrama de secuencia: Inicio de sesión

actor Conductor
participant "App Flutter" as App
participant Google
participant "Backend Java" as Backend
database PostgreSQL as BD

Conductor -> App : Iniciar sesión
App -> Google : Solicitar autenticación
Google --> App : Token de Google
App -> Backend : POST /sesion (token)
Backend -> Google : Validar token
Google --> Backend : Datos del usuario
Backend -> BD : Buscar o crear conductor
BD --> Backend : Conductor
Backend --> App : JWT + token de renovación
App --> Conductor : Mostrar mapa

@enduml
