@startuml SEC-03_VotarEvento
' Diagrama de secuencia general: votar un evento (real / falso)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 8
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #222222
  ActorBackgroundColor white
  ActorBorderColor #222222
  LifeLineBorderColor #555555
  LifeLineBackgroundColor white
  GroupBorderColor #777777
  GroupBackgroundColor white
  ArrowThickness 1.2
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
skinparam database {
  BackgroundColor white
  BorderColor #222222
}
skinparam responseMessageBelowArrow true
hide footbox
autonumber

title Diagrama de secuencia: Votar evento

actor Conductor
participant "App Flutter" as App
participant "Backend Java" as Backend
database PostgreSQL as BD

Conductor -> App : Votar «real» o «falso»
App -> Backend : POST /eventos/{id}/votos
Backend -> BD : Guardar voto
Backend -> Backend : Recalcular estado del evento
alt votos suficientes «real»
  Backend -> BD : Estado = Confirmado
else votos suficientes «falso»
  Backend -> BD : Estado = Retirado
end
Backend --> App : Estado actualizado
App --> Conductor : Mostrar resultado

@enduml
