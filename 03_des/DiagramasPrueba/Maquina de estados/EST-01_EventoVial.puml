@startuml EST-01_EventoVial
' Diagrama de estados general: EventoVial
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 22
skinparam state {
  BackgroundColor white
  BorderColor #222222
  BorderThickness 1.5
  StartColor #222222
  EndColor #222222
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
hide empty description

title Diagrama de estados: EventoVial

state Activo
state Confirmado
state Retirado
state Vencido

[*] --> Activo : reporte aceptado
Activo --> Confirmado : votos «real»
Activo --> Retirado : votos «falso»
Activo --> Vencido : vigencia superada
Confirmado --> Vencido : vigencia superada
Retirado --> [*]
Vencido --> [*]

@enduml
