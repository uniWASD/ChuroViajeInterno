@startuml EST-04_ReporteEnApp
' Diagrama de estados general: reporte de evento en la app
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 22
skinparam state {
  BackgroundColor white
  BorderColor #222222
  BorderThickness 1.5
  StartColor #222222
  EndColor #222222
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
hide empty description

title Diagrama de estados: Reporte de evento (app)

state "En cola" as EnCola
state Enviado
state Aceptado
state Rechazado
state Descartado

[*] --> Enviado : hay conexión
[*] --> EnCola : sin conexión
EnCola --> Enviado : vuelve la conexión
EnCola --> Descartado : venció
Enviado --> Aceptado : backend acepta
Enviado --> Rechazado : backend rechaza
Aceptado --> [*]
Rechazado --> [*]
Descartado --> [*]

@enduml
