@startuml EST-06_EstadoCombustible
' Diagrama de estados general: estado de combustible de un surtidor
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 22
skinparam state {
  BackgroundColor white
  BorderColor #222222
  BorderThickness 1.5
  StartColor #222222
  EndColor #222222
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
hide empty description

title Diagrama de estados: EstadoCombustible

state "Sin información" as SinInfo
state Disponible
state Agotado

[*] --> SinInfo
SinInfo --> Disponible : llega dato\n«disponible»
SinInfo --> Agotado : llega dato\n«agotado»
Disponible --> Agotado : dato más reciente\n«agotado»
Agotado --> Disponible : dato más reciente\n«disponible»
Disponible --> SinInfo : 6 horas sin dato
Agotado --> SinInfo : 6 horas sin dato

@enduml
