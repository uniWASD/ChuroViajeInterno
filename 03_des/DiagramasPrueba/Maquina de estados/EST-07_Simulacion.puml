@startuml EST-07_Simulacion
' Diagrama de estados general: Simulación de carga
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 22
skinparam state {
  BackgroundColor white
  BorderColor #222222
  BorderThickness 1.5
  StartColor #222222
  EndColor #222222
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
hide empty description

title Diagrama de estados: Simulación

state Configurada
state Ejecutando
state Finalizada
state Interrumpida
state Rechazada

[*] --> Configurada
Configurada --> Ejecutando : parámetros válidos
Configurada --> Rechazada : parámetros inválidos
Ejecutando --> Finalizada : eventos enviados
Ejecutando --> Interrumpida : falla o se interrumpe
Finalizada --> [*] : datos simulados\neliminados
Interrumpida --> [*] : datos simulados\neliminados
Rechazada --> [*]

@enduml
