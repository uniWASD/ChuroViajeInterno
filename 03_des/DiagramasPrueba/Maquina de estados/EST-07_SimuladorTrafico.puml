@startuml EST-07_SimuladorTrafico
' Diagrama de estados general: Simulador de tráfico (CU-07)
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam ArrowColor #222222
skinparam backgroundColor white
skinparam titleBorderThickness 1
skinparam titleBorderColor #333333
skinparam titleBorderRoundCorner 0
skinparam titleFontSize 15
skinparam titleBackgroundColor white
skinparam roundCorner 22
skinparam state {
  BackgroundColor white
  BorderColor #222222
  BorderThickness 1.5
  StartColor #222222
  EndColor #222222
}
skinparam note {
  BackgroundColor white
  BorderColor #777777
}
hide empty description

title Diagrama de estados: Simulador de tráfico

state Configurado
state Ejecutando
state Realizado
state Interrumpido
state Rechazado

[*] --> Configurado : desarrollador define\nusuarios, rutas y eventos
Configurado --> Ejecutando : parámetros válidos
Configurado --> Rechazado : parámetros inválidos
Ejecutando --> Realizado : todos los eventos\nfueron enviados
Ejecutando --> Interrumpido : falla o se interrumpe
Realizado --> [*] : datos simulados\neliminados
Interrumpido --> [*] : datos simulados\neliminados
Rechazado --> [*]

@enduml
