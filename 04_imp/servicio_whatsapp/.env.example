# Copiar como .env en la carpeta del servicio para npm start (opcional).
# Solo valores de ejemplo; usar secretos externos y permisos restringidos en producción.
BACKEND_URL=http://127.0.0.1:18080
SERVICE_TOKEN=EJEMPLO_FICTICIO_NO_USAR_EN_PRODUCCION
SERVICE_AUTH_HEADER=Authorization
SERVICE_TOKEN_PREFIX="Bearer "
ALLOWED_GROUP_IDS=grupo-simulado@g.us
LLM_API_KEY=
# Análisis por lotes (issue #59). Sin LLM_API_KEY no se llama al LLM.
LLM_MODEL=gemini-3.1-flash-lite
ANALYSIS_INTERVAL_MS=300000
SQLITE_PATH=./data/pendientes.sqlite
MAINTENANCE_INTERVAL_MS=60000

# Lectura de grupos de WhatsApp (HU-08). Apagada por defecto; ver el README.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER=
WHATSAPP_SESSION_PATH=./data/session.sqlite
WHATSAPP_AUTHORIZATIONS_FILE=
WHATSAPP_RECONNECT_MS=15000
